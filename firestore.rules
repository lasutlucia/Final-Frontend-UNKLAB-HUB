rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /events/{eventId} {
      allow read: if resource.data.status == 'approved' || isAdmin() ||
        (signedIn() && resource.data.organizerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() || (signedIn() && resource.data.organizerId == request.auth.uid &&
        request.resource.data.organizerId == resource.data.organizerId &&
        request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'mahasiswa' &&
        request.resource.data.email == request.auth.token.email);
      allow update: if signedIn() && request.auth.uid == userId &&
        (request.resource.data.role == resource.data.role ||
          (!('role' in resource.data) && request.resource.data.role == 'mahasiswa'));
      allow delete: if isAdmin();
    }
    match /bookmarks/{bookmarkId} {
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
    match /mySchedule/{scheduleId} {
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
  }
}
